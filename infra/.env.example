# ----- Nodo de aplicación (docker-compose.app.yml) -----
# IP PRIVADA de la EC2 de mensajería (RabbitMQ + Kafka)
MESSAGING_HOST=172.31.0.10
# Dominio público HTTPS de la EC2 de aplicación (IP elástica con guiones + .nip.io)
PUBLIC_HOST=3-90-12-34.nip.io
# URL del API Gateway (https) a la que llama el frontend
API_BASE_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
DB_USERNAME=pedidos
DB_PASSWORD=cambiar-esta-clave
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ----- Nodo de mensajería (docker-compose.rabbitmq.yml / docker-compose.kafka.yml) -----
# IP PRIVADA de la propia EC2 de mensajería (la anuncian los brokers de Kafka)
KAFKA_EXTERNAL_HOST=172.31.0.10
